flow stage_validate(acc: string, item: string) -> string { return acc + "v" + item; } flow stage_dispatch(acc: string, item: string) -> string { return acc + "d" + item; } flow main() -> string { var validated = ""; var dispatched = ""; for task_a in ["read", "write", "shell", "git", "web"] limit Iterations(5) { validated = stage_validate(validated, task_a); } for task_b in ["read", "write", "shell", "git", "web"] limit Iterations(5) { dispatched = stage_dispatch(dispatched, task_b); } return validated + dispatched; }
