type BoundedPipelineStage; @optimization([BoundedPipelineStage]) flow pipeline_encode(acc: string, item: string) -> string { return acc + "e" + item; } @optimization([BoundedPipelineStage]) flow pipeline_route(acc: string, item: string) -> string { return acc + "r" + item; } flow main() -> string { var encoded = ""; var routed = ""; for task_a in ["fs", "git", "db", "mail", "chat"] limit Iterations(5) { encoded = pipeline_encode(encoded, task_a); } for task_b in ["fs", "git", "db", "mail", "chat"] limit Iterations(5) { routed = pipeline_route(routed, task_b); } return encoded + routed; }
