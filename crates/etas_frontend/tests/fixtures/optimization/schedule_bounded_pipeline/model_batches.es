flow stage_prepare(acc: string, item: string) -> string { return acc + "p" + item; } flow stage_collect(acc: string, item: string) -> string { return acc + "c" + item; } flow main() -> string { var prepared = ""; var collected = ""; for task_a in ["q1", "q2", "q3", "q4", "q5"] limit Iterations(5) { prepared = stage_prepare(prepared, task_a); } for task_b in ["q1", "q2", "q3", "q4", "q5"] limit Iterations(5) { collected = stage_collect(collected, task_b); } return prepared + collected; }
