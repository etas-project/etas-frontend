flow pipeline_validate(acc: string, item: string) -> string { return acc + "v" + item; } flow pipeline_commit(acc: string, item: string) -> string { return acc + "c" + item; } flow main() -> string { var validated = ""; var committed = ""; for task_a in ["m1", "m2", "m3", "m4", "m5"] limit Iterations(5) { validated = pipeline_validate(validated, task_a); } for task_b in ["m1", "m2", "m3", "m4", "m5"] limit Iterations(5) { committed = pipeline_commit(committed, task_b); } return validated + committed; }
