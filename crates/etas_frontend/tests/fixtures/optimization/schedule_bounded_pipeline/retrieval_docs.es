type BoundedPipelineStage; @optimization([BoundedPipelineStage]) flow schedule_rank(acc: string, item: string) -> string { return acc + "r" + item; } @optimization([BoundedPipelineStage]) flow schedule_pack(acc: string, item: string) -> string { return acc + "p" + item; } flow main() -> string { var ranked = ""; var packed = ""; for task_a in ["d1", "d2", "d3", "d4", "d5"] limit Iterations(5) { ranked = schedule_rank(ranked, task_a); } for task_b in ["d1", "d2", "d3", "d4", "d5"] limit Iterations(5) { packed = schedule_pack(packed, task_b); } return ranked + packed; }
