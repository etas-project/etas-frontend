flow schedule_load(acc: string, item: string) -> string { return acc + "l" + item; } flow schedule_check(acc: string, item: string) -> string { return acc + "c" + item; } flow main() -> string { var loaded = ""; var checked = ""; for task_a in ["p1", "p2", "p3", "p4", "p5"] limit Iterations(5) { loaded = schedule_load(loaded, task_a); } for task_b in ["p1", "p2", "p3", "p4", "p5"] limit Iterations(5) { checked = schedule_check(checked, task_b); } return loaded + checked; }
