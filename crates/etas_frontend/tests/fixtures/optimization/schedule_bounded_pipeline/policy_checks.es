type BoundedPipelineStage; @optimization([BoundedPipelineStage]) flow stage_expand(acc: string, item: string) -> string { return acc + "e" + item; } @optimization([BoundedPipelineStage]) flow stage_audit(acc: string, item: string) -> string { return acc + "a" + item; } flow main() -> string { var expanded = ""; var audited = ""; for task_a in ["r1", "r2", "r3", "r4", "r5"] limit Iterations(5) { expanded = stage_expand(expanded, task_a); } for task_b in ["r1", "r2", "r3", "r4", "r5"] limit Iterations(5) { audited = stage_audit(audited, task_b); } return expanded + audited; }
