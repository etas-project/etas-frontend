type BoundedPipelineStage; @optimization([BoundedPipelineStage]) flow schedule_parse(acc: string, item: string) -> string { return acc + "p" + item; } @optimization([BoundedPipelineStage]) flow schedule_index(acc: string, item: string) -> string { return acc + "i" + item; } flow main() -> string { var parsed = ""; var indexed = ""; for task_a in ["a.rs", "b.rs", "c.rs", "d.rs", "e.rs"] limit Iterations(5) { parsed = schedule_parse(parsed, task_a); } for task_b in ["a.rs", "b.rs", "c.rs", "d.rs", "e.rs"] limit Iterations(5) { indexed = schedule_index(indexed, task_b); } return parsed + indexed; }
