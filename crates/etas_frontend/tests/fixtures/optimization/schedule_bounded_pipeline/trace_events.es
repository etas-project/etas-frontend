flow stage_normalize(acc: string, item: string) -> string { return acc + "n" + item; } flow stage_export(acc: string, item: string) -> string { return acc + "x" + item; } flow main() -> string { var normalized = ""; var exported = ""; for task_a in ["s1", "s2", "s3", "s4", "s5"] limit Iterations(5) { normalized = stage_normalize(normalized, task_a); } for task_b in ["s1", "s2", "s3", "s4", "s5"] limit Iterations(5) { exported = stage_export(exported, task_b); } return normalized + exported; }
