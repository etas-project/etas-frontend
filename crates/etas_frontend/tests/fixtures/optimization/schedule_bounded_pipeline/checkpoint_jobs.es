type BoundedPipelineStage; @optimization([BoundedPipelineStage]) flow pipeline_snapshot(acc: string, item: string) -> string { return acc + "s" + item; } @optimization([BoundedPipelineStage]) flow pipeline_persist(acc: string, item: string) -> string { return acc + "p" + item; } flow main() -> string { var snapped = ""; var persisted = ""; for task_a in ["c1", "c2", "c3", "c4", "c5"] limit Iterations(5) { snapped = pipeline_snapshot(snapped, task_a); } for task_b in ["c1", "c2", "c3", "c4", "c5"] limit Iterations(5) { persisted = pipeline_persist(persisted, task_b); } return snapped + persisted; }
