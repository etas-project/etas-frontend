type ReusableResourceFactory; @optimization([ReusableResourceFactory]) flow connect_vector_store(name: string) -> string { return name + ":store"; } flow main() -> string { var out = ""; for item in ["q1", "q2", "q3", "q4", "q5"] limit Iterations(5) { let store = connect_vector_store("docs"); out = out + store + item; } return out; }
