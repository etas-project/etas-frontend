type ReusableResourceFactory; @optimization([ReusableResourceFactory]) flow connect_mcp_channel(name: string) -> string { return name + ":channel"; } flow main() -> string { var out = ""; for item in ["fs", "git", "db", "mail", "chat"] limit Iterations(5) { let channel = connect_mcp_channel("stdio"); out = out + channel + item; } return out; }
