type ReusableResourceFactory; @optimization([ReusableResourceFactory]) flow open_tool_host(name: string) -> string { return name + ":host"; } flow main() -> string { var out = ""; for item in ["read", "write", "shell", "git", "web"] limit Iterations(5) { let host = open_tool_host("local"); out = out + host + item; } return out; }
