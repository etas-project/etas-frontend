flow main() -> bool { var first = false; var second = false; for key_a in ["Cargo.toml", "src/lib.rs", "README.md", "tests/main.es", "AGENTS.md"] limit Iterations(5) { if key_a == "src/lib.rs" { first = true; } } for key_b in ["Cargo.toml", "src/lib.rs", "README.md", "tests/main.es", "AGENTS.md"] limit Iterations(5) { if key_b == "AGENTS.md" { second = true; } } if first { return second; } return false; }
